{
  "name": "soundcheck-report-app",
  "private": true,
  "type": "module",
  "description": "The run page: the live page and the export. `npm run build` writes ../src/report/app.js, which soundcheck includes.",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit && node build.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "preact-render-to-string": "6.8.2",
    "typescript": "7.0.2"
  }
}
